rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() { return request.auth != null && request.auth.token.email == 'akasherror360@gmail.com' && request.auth.token.email_verified == true; }
    match /publicPages/{page} { allow read: if true; allow create, update, delete: if isOwner(); }
    match /draftPages/{page} { allow read, create, update, delete: if isOwner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
